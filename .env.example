# ===== Server =====
PORT=8080
CLIENT_ORIGIN=*                       # CORS 허용 오리진 ('*' 또는 https://example.com)

# ===== File upload =====
UPLOAD_DIR=uploads                    # 업로드 파일 로컬 저장 디렉터리
MAX_FILE_SIZE_MB=20                   # 업로드 허용 최대 크기(MB)

# ===== AI Orchestrator (FastAPI) 연결 =====
AI_ORCHESTRATOR_URL=http://localhost:8000   # 운영 시 RunPod/SageMaker 게이트 URL로 교체
AI_TIMEOUT_MS=120000                  # 모델 추론이 느릴 수 있어 길게(기본 120초)
